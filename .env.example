# Configuration du système de vente de tickets

# Environnement
NODE_ENV=development

# Port du serveur
PORT=3000

# Secret JWT pour l'authentification (CHANGEZ CECI EN PRODUCTION !)
JWT_SECRET=votre_secret_jwt_super_securise

# Configuration de la base de données
DB_PATH=./tickets.db

# Configuration de sécurité
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configuration des emails (optionnel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-app

# Configuration des paiements (optionnel)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Configuration des logs
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Configuration de performance
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Configuration de sécurité avancée
SESSION_SECRET=votre_session_secret
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true